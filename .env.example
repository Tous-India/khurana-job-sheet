# MongoDB Atlas connection string — free tier at mongodb.com/atlas.
#
# The database name (/khurana below) is REQUIRED and Atlas omits it from the
# string its Connect dialog shows you: it gives you ".../?retryWrites=true",
# which silently uses the default `test` database instead.
#
# In Atlas under Network Access, add 0.0.0.0/0 to the IP allowlist — Vercel's
# serverless functions have no fixed egress IPs, so a restricted allowlist
# blocks the deployment while still working from a developer machine.
DATABASE_URL="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/khurana?retryWrites=true&w=majority"

# Public base URL, used to build shareable PDF links for WhatsApp.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Google review link, rendered as a QR code in the PDF confirmation block.
# Left empty, the QR is simply omitted. The letterhead already carries a BILLS
# dealer QR and a UPI payment QR — see README 6.2.
# CLIENT TO SUPPLY — see README section 12.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=""

# Vercel Blob storage token — required for photo uploads on any deployed environment.
# Vercel's filesystem is read-only at runtime, so /public/uploads works ONLY in local dev.
BLOB_READ_WRITE_TOKEN=""

# Contact email sent in the Nominatim User-Agent header (their usage policy requires one).
# CLIENT TO SUPPLY — see README section 12.
NOMINATIM_CONTACT_EMAIL="contact@khuranaelectronics.example"
